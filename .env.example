# ─────────────────────────────────────────────────────────────────────────────
# Tarjuman — environment configuration
#
# Copy to .env and fill in. Every value below has a working default, so the app
# boots with an empty .env. The only one you should change before deploying is
# SECRET_KEY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Signing key for JWTs. MUST be changed for any deployment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left at the default, the app logs a loud warning at startup and refuses to
# start when APP_ENV=production.
SECRET_KEY=dev-only-insecure-key-change-me

# JWT lifetime in minutes. 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Application ──────────────────────────────────────────────────────────────
# development | production
# In production: /docs and /redoc are disabled, and a default SECRET_KEY is fatal.
APP_ENV=development

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Default is SQLite in the working directory — no setup required.
# For PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
# (requires: pip install -e ".[postgres]")
DATABASE_URL=sqlite:///./tarjuman.db

# ── Translation provider ─────────────────────────────────────────────────────
# MyMemory needs no API key. The free tier is rate-limited per IP per day.
# To raise the limit, register a free account and put the address here — it is
# sent as the `de` parameter and gets you a larger daily word allowance.
MYMEMORY_EMAIL=

# Seconds before a provider request is abandoned.
PROVIDER_TIMEOUT_SECONDS=20

# Retry attempts on 5xx and network errors. 4xx is never retried.
PROVIDER_MAX_RETRIES=2

# ── Caching ──────────────────────────────────────────────────────────────────
# In-process TTL cache for provider responses. 0 disables it.
# NOTE: this is per-worker. With N workers you get N caches.
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=2000

# ── Rate limiting ────────────────────────────────────────────────────────────
# Requests per window, per client IP, on the expensive /api/translate endpoint.
# NOTE: per-process. N workers means N× this limit in aggregate.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Limits ───────────────────────────────────────────────────────────────────
# Maximum characters accepted in a single translation request.
MAX_TEXT_LENGTH=5000

# Maximum request body size in bytes. Anything larger is rejected before parsing.
MAX_REQUEST_BYTES=262144

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
# Leave empty to allow same-origin only (the default, and the safe choice).
# Example: https://tarjuman.example.com,https://www.tarjuman.example.com
CORS_ORIGINS=
